generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TEACHER
  PRINCIPAL
  STUDENT
}

enum Term {
  FIRST
  SECOND
  THIRD
}

enum ApprovalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PUBLISHED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
}

enum SubjectType {
  CORE
  ELECTIVE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teacher      Teacher?
  student      Student?
  auditLogs    AuditLog[]

  @@index([role])
}

model Student {
  id             String   @id @default(cuid())
  userId         String?  @unique
  admissionNo    String   @unique
  firstName      String
  middleName     String?
  lastName       String
  gender         Gender
  dateOfBirth    DateTime?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  enrollments    Enrollment[]
  results        Result[]
  assignments    Assignment[]

  @@index([lastName, firstName])
}

model Teacher {
  id             String   @id @default(cuid())
  userId         String   @unique
  staffNo        String   @unique
  firstName      String
  lastName       String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments    TeacherAssignment[]
  createdResults Result[]

  @@index([lastName, firstName])
}

model Class {
  id             String   @id @default(cuid())
  name           String
  level          String
  arm            String?
  stream         String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  enrollments    Enrollment[]
  assignments    TeacherAssignment[]
  results        Result[]

  @@unique([name, arm])
}

model Subject {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  type           SubjectType @default(CORE)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignments    TeacherAssignment[]
  results        Result[]
}

model AcademicSession {
  id             String   @id @default(cuid())
  name           String   @unique
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean  @default(false)
  createdAt      DateTime @default(now())

  enrollments    Enrollment[]
  results        Result[]
}

model Enrollment {
  id             String   @id @default(cuid())
  studentId      String
  classId        String
  sessionId      String
  term           Term
  createdAt      DateTime @default(now())

  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class          Class           @relation(fields: [classId], references: [id], onDelete: Restrict)
  session        AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  results        Result[]

  @@unique([studentId, sessionId, term])
  @@index([classId, sessionId, term])
}

model TeacherAssignment {
  id          String   @id @default(cuid())
  teacherId   String
  classId     String
  subjectId   String
  sessionId   String
  term        Term
  createdAt   DateTime @default(now())

  teacher     Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class       Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classId, subjectId, sessionId, term])
  @@index([classId, subjectId, sessionId, term])
}

model Result {
  id             String         @id @default(cuid())
  studentId      String
  enrollmentId   String
  classId        String
  subjectId      String
  sessionId      String
  term           Term

  caScore        Decimal        @db.Decimal(5, 2)
  examScore      Decimal        @db.Decimal(5, 2)
  totalScore     Decimal        @db.Decimal(5, 2)

  grade          String?
  remark         String?
  position       Int?

  classAverage   Decimal?       @db.Decimal(5, 2)
  performanceRate Decimal?      @db.Decimal(5, 2)

  status         ApprovalStatus @default(DRAFT)

  enteredById    String?
  approvedAt    DateTime?
  publishedAt   DateTime?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment     Enrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  class          Class           @relation(fields: [classId], references: [id], onDelete: Restrict)
  subject        Subject         @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  session        AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  teacher        Teacher?        @relation(fields: [enteredById], references: [id], onDelete: SetNull)

  @@unique([studentId, subjectId, sessionId, term])
  @@index([classId, subjectId, sessionId, term])
  @@index([studentId, sessionId, term])
  @@index([status])
}

model GradingScale {
  id          String   @id @default(cuid())
  name        String
  minScore    Decimal  @db.Decimal(5, 2)
  maxScore    Decimal  @db.Decimal(5, 2)
  grade       String
  remark      String?
  createdAt   DateTime @default(now())

  @@unique([name, grade])
  @@index([minScore, maxScore])
}

model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  studentId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student     Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entity      String
  entityId    String?
  details     Json?
  createdAt   DateTime @default(now())

  user        User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}